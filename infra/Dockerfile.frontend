# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS build
WORKDIR /src

COPY frontend/package.json frontend/package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm \
    npm install --no-audit --no-fund

COPY frontend/ ./

# Auth UI (Keycloak / OIDC). Vite reads process env at build time — ARG alone is not enough;
# these ENV lines are required. Defaults match local docker-compose (dev header auth).
# For Kubernetes / OIDC you MUST pass --build-arg (see docs/deployment-argocd.md).
ARG VITE_AUTH_MODE=dev
ARG VITE_OIDC_AUTHORITY=
ARG VITE_OIDC_CLIENT_ID=
ARG VITE_OIDC_SCOPE=openid profile email
ARG VITE_PUBLIC_CLAIM_ENABLED=false
# CI passes STASH_VERSION on tag pipelines (the same semver baked into the
# backend's app.Version). rsbuild.config.ts inlines it via process.env.
ARG STASH_VERSION=dev
ENV VITE_AUTH_MODE=$VITE_AUTH_MODE \
    VITE_OIDC_AUTHORITY=$VITE_OIDC_AUTHORITY \
    VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID \
    VITE_OIDC_SCOPE=$VITE_OIDC_SCOPE \
    VITE_PUBLIC_CLAIM_ENABLED=$VITE_PUBLIC_CLAIM_ENABLED \
    STASH_VERSION=$STASH_VERSION

# Fail fast if someone asks for oidc but forgets authority/client (avoids "undefined" in bundles).
RUN if [ "$VITE_AUTH_MODE" = "oidc" ] && { [ -z "$VITE_OIDC_AUTHORITY" ] || [ -z "$VITE_OIDC_CLIENT_ID" ]; }; then \
      echo "Dockerfile: VITE_AUTH_MODE=oidc requires non-empty VITE_OIDC_AUTHORITY and VITE_OIDC_CLIENT_ID (pass --build-arg)."; \
      exit 1; \
    fi

RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /src/dist /usr/share/nginx/html
# docker-compose uses backend:8080; Kubernetes uses stash-backend:8080 (nginx.k8s.conf).
ARG NGINX_CONF=nginx.conf
COPY infra/${NGINX_CONF} /etc/nginx/conf.d/default.conf
EXPOSE 80
