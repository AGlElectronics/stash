# Backend
APP_ENV=development
APP_BASE_URL=http://localhost:8080
HTTP_ADDR=:8080

# PostgreSQL (matches infra/docker-compose.yml defaults)
DATABASE_URL=postgres://stash:stash@localhost:5432/stash?sslmode=disable

# Object storage — provider-neutral S3 API. One dedicated bucket per module.
#
# Local Docker Desktop Compose may use MinIO on localhost (below).
# MinIO is NEVER for production — prod must use managed S3-compatible storage
# (AWS S3, GCS via S3 API, etc.), IAM/keys in Secrets, typically path-style false.
#
# Kubernetes temporary buckets (if any) are still not a production posture;
# see docs/deployment-argocd.md.
#
# New uploads use keys: stash/<entity_type>/<entity_id>/<uuid>.<ext>
# (older rows may still reference legacy paths like item/<id>/…).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=stash-dev
S3_ACCESS_KEY_ID=stash
S3_SECRET_ACCESS_KEY=stashstash
S3_REGION=us-east-1
# MinIO and many self-hosted endpoints need true; most AWS SDK defaults use false.
S3_USE_PATH_STYLE=true
# Optional: rewrite presigned URL host for browsers (see backend internal/files/client.go)
# S3_PUBLIC_BASE_URL=

# Auth: 'dev' uses X-Dev-User header; 'oidc' uses bearer JWT verification
AUTH_MODE=dev
DEV_DEFAULT_USER=dev-admin
# Keycloak realm issuer, e.g. https://auth.example.com/realms/conservices
OIDC_ISSUER_URL=
# Same client as in Keycloak (audience often equals client id for public SPAs)
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
# Access config file (roles → permissions + OIDC group → role bindings).
# Required when AUTH_MODE=oidc; optional in dev mode (dev users are admins).
# Edit infra/access-config.toml locally, or set ACCESS_CONFIG_PATH to your copy.
# ACCESS_CONFIG_PATH=/etc/stash/access.toml
# Legacy name (still supported): OIDC_BINDINGS_PATH

# CORS for the frontend dev server
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Guest Lost & Found self-service (/claim page + /api/public/lostfound).
# Enabled for local dev; set false in production until guest kiosks are ready.
PUBLIC_LOSTFOUND_CLAIM_ENABLED=true
VITE_PUBLIC_CLAIM_ENABLED=true

# Local stack with docker-compose.local.yml also starts Adminer on http://localhost:8082
# (PostgreSQL → server: postgres, user/password/db: stash).
#
# Access config: edit infra/access-config.toml, copy to local path, restart backend:
#   copy infra\access-config.toml %LOCALAPPDATA%\stash\access-config.toml
#   docker compose --env-file .env -f infra/docker-compose.yml -f infra/docker-compose.local.yml up -d backend
STASH_ACCESS_CONFIG=C:/Users/alanv/AppData/Local/stash/access-config.toml

# Frontend API base (dev server). Leave empty when the SPA is served behind the same origin as /api (Docker nginx).
VITE_API_BASE_URL=http://localhost:8080

# Frontend auth: dev = automatic X-Dev-User; oidc = Keycloak login via oidc-client-ts
VITE_AUTH_MODE=dev
# Keycloak realm URL (must match OIDC_ISSUER_URL) and public SPA client id
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile email

# Keycloak client setup (public / SPA):
# - Valid redirect URIs: http://localhost:3000/auth/callback http://localhost:5173/auth/callback
# - Web origins: http://localhost:3000 http://localhost:5173
# Rebuild the frontend image after changing VITE_* values.
